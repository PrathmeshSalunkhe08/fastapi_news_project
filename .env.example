# LLM API Keys (Set the one you wish to use)
# Groq is recommended (free tier available at https://console.groq.com)
GROQ_API_KEY=

# Or OpenAI / Google Gemini
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM Model Name (Optional, defaults to llama-3.3-70b-versatile for Groq)
LLM_MODEL=llama-3.3-70b-versatile
